{
  "expo": {
    "name": "gerenciador-financeiro",
    "slug": "sonic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.gerenciador-financeiro",
      "appleTeamId": "4TJH92XDGN",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.gerenciadorfinanceiro"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "gerenciadorfinanceiro",
    "plugins": [
      "expo-router",
      "@bacons/apple-targets",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.anonymous.gerenciador-financeiro.widget",
                  "targetName": "GastoWidget"
                }
              ]
            }
          }
        },
        "projectId": "0e8d3b82-e34a-436b-9988-1b7e908e5b2d"
      }
    },
    "owner": "sonics-team"
  }
}
